{
  "name": "@rook/google-workspace",
  "version": "0.1.0",
  "description": "Browser-native typed Google Workspace client and model skill for Rook",
  "homepage": "https://github.com/WebMCP-org/rook-integrations#readme",
  "bugs": {
    "url": "https://github.com/WebMCP-org/rook-integrations/issues"
  },
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WebMCP-org/rook-integrations.git"
  },
  "files": [
    "discovery",
    "dist",
    "skills",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/google-workspace.js",
  "types": "./dist/google-workspace.d.ts",
  "exports": {
    ".": {
      "types": "./dist/google-workspace.d.ts",
      "import": "./dist/google-workspace.js",
      "default": "./dist/google-workspace.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check && vp run typecheck && vp run test && vp run validate:package",
    "check:generated": "node scripts/generate-google-workspace.mjs --check",
    "generate": "node scripts/generate-google-workspace.mjs",
    "prepublishOnly": "vp run validate:package",
    "test": "vp run test:contract && vp run test:browser",
    "test:browser": "vp exec vitest run --config vitest.browser.config.ts",
    "test:contract": "vp exec vitest run test/google-workspace-application.contract.test.ts",
    "typecheck": "vp run check:generated && vp exec tsc --noEmit",
    "validate:package": "vp exec -- node scripts/validate-package.mjs"
  },
  "dependencies": {
    "mimetext": "3.0.28"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "0.3.1",
    "vitest": "4.1.11",
    "zod": "4.6.4"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.9.0"
}
